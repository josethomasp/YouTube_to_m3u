llion...\\n\\n\\nFollow Twentyfour News to catch up on the latest trends and News.\\n\\nFacebook   : \xc2\xa0\xc2\xa0/\xc2\xa024onlive\xc2\xa0\xc2\xa0\\nTwitter        : \xc2\xa0\xc2\xa0/\xc2\xa024onlive\xc2\xa0\xc2\xa0\\nInstagram  : \xc2\xa0\xc2\xa0/\xc2\xa024onlive\xc2\xa0\xc2\xa0\\n\\n#MalayalamNews #latestnews #LiveUpdates  #24News","commandRuns":[{"startIndex":494,"length":29,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBIQ040EGAQiEwiI28mdioeWAxUFDGgIHWMCNplI9-PljKfWwIDXAcoBBLLxFMM=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUM4Zm9rU1BGVE9BMUVtdy1CMVpkQlNhb1FyYnxBR3JiS2FtVEswaWhKLWxpbVpIeUlXQWZnakFJZTFMbFo4SXl5bW1JNldNcXdfN2E3V1JjdzNpRmtlYXZvaFE3d1RDUUhhWWFaVUdpZEhQSzdONUhReEVtQVFOVlRZbENWTmVh\\u0026q=http%3A%2F%2Fwww.twentyfournews.com%2F\\u0026v=1wECsnGZcfc","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUM4Zm9rU1BGVE9BMUVtdy1CMVpkQlNhb1FyYnxBR3JiS2FtVEswaWhKLWxpbVpIeUlXQWZnakFJZTFMbFo4SXl5bW1JNldNcXdfN2E3V1JjdzNpRmtlYXZvaFE3d1RDUUhhWWFaVUdpZEhQSzdONUhReEVtQVFOVlRZbENWTmVh\\u0026q=http%3A%2F%2Fwww.twentyfournews.com%2F\\u0026v=1wECsnGZcfc","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":603,"length":21,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBIQ040EGAQiEwiI28mdioeWAxUFDGgIHWMCNplI9-PljKfWwIDXAcoBBLLxFMM=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUM4Zm9rVG5kV0FzS0dCS2RJa3FyZW9HMVZWSXxBR3JiS2FrNEJpenUzOEZIM0Z6RDNzU0lUeHBlRDJxd2VGNU43enRKekxVeGEzQm1wNWs0bXQ0UnpIUnBBTEVJSWgzMVRuMmtfOUtWTFlrR2R0cjJkUTdzcjRoRF92dWc4ZkdI\\u0026q=https%3A%2F%2Fgoo.gl%2FQ5LMwv\\u0026v=1wECsnGZcfc","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUM4Zm9rVG5kV0FzS0dCS2RJa3FyZW9HMVZW