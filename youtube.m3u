le app store : https://play.google.com/store/apps/de...\\n\\nApple Store: https://apps.apple.com/in/app/million...\\n\\n\\nFollow Twentyfour News to catch up on the latest trends and News.\\n\\nFacebook   : \xc2\xa0\xc2\xa0/\xc2\xa024onlive\xc2\xa0\xc2\xa0\\nTwitter        : \xc2\xa0\xc2\xa0/\xc2\xa024onlive\xc2\xa0\xc2\xa0\\nInstagram  : \xc2\xa0\xc2\xa0/\xc2\xa024onlive\xc2\xa0\xc2\xa0\\n\\n#MalayalamNews #latestnews #LiveUpdates  #24News","commandRuns":[{"startIndex":494,"length":29,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBIQ040EGAQiEwj1k9OxkuuVAxVLMGgIHZOmHp1I9-PljKfWwIDXAcoBBIKXzx8=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUM4Zm9rUWMyS2k3RWl5OVhrU0JLb3NKLWpQSnxBR3JiS2FrcmlPVlVzSGs5RFp6cm1qNU84M2F5OUFtUmZRU3pJNlhBTXZMSDJxSWM3NjNYV2x6OTNmOEtnTXRIVHJyYk42NTlmaXFPcU5ocU5JTjg4b1BtSkNKSW1nSXZTYUl1\\u0026q=http%3A%2F%2Fwww.twentyfournews.com%2F\\u0026v=1wECsnGZcfc","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUM4Zm9rUWMyS2k3RWl5OVhrU0JLb3NKLWpQSnxBR3JiS2FrcmlPVlVzSGs5RFp6cm1qNU84M2F5OUFtUmZRU3pJNlhBTXZMSDJxSWM3NjNYV2x6OTNmOEtnTXRIVHJyYk42NTlmaXFPcU5ocU5JTjg4b1BtSkNKSW1nSXZTYUl1\\u0026q=http%3A%2F%2Fwww.twentyfournews.com%2F\\u0026v=1wECsnGZcfc","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":603,"length":21,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBIQ040EGAQiEwj1k9OxkuuVAxVLMGgIHZOmHp1I9-PljKfWwIDXAcoBBIKXzx8=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUM4Zm9rUWp2NjZVVkFpNWJWWFVFQ2s3cmJiR3xBR3JiS2FuTFVBT0hHXzdEZF9rVkVlV0MtSkVGNHhIOW5BM2hiQmRodHIycXN0dzZ5MHRtUG1QbmVoM2Q5U0hONzFRXzNCU0kzZHk0bzF6RTVLRGNfaVNFb3o1WktpeFRmNnB2\\u0026q=https%3A%2F%2Fgoo.gl%2FQ5LMwv\\u0026v=1wECsnGZcfc","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https