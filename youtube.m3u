ion...\\n\\n\\nFollow Twentyfour News to catch up on the latest trends and News.\\n\\nFacebook   : \xc2\xa0\xc2\xa0/\xc2\xa024onlive\xc2\xa0\xc2\xa0\\nTwitter        : \xc2\xa0\xc2\xa0/\xc2\xa024onlive\xc2\xa0\xc2\xa0\\nInstagram  : \xc2\xa0\xc2\xa0/\xc2\xa024onlive\xc2\xa0\xc2\xa0\\n\\n#MalayalamNews #latestnews #LiveUpdates  #24News","commandRuns":[{"startIndex":494,"length":29,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBIQ040EGAQiEwiW8NCDn8eWAxVGClcBHcVzHNdI9-PljKfWwIDXAcoBBA1CCm8=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUM4Zm9rUkRENmRTV3pBTHJ0cTVjUXU3cndVM3xBR3JiS2FsdXdKLThQZVd3OTN1NGVRSDZ2MHlSdHc3ZDIxWExrbTZMS2lMVmNHQ0JxVUV4ZFBfWGxVbFJRRXBDTTd3WDBTUTlxTEFPLVp2a0tEVXBtZnJwNU4zTWR2ZjNMVXpq\\u0026q=http%3A%2F%2Fwww.twentyfournews.com%2F\\u0026v=1wECsnGZcfc","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUM4Zm9rUkRENmRTV3pBTHJ0cTVjUXU3cndVM3xBR3JiS2FsdXdKLThQZVd3OTN1NGVRSDZ2MHlSdHc3ZDIxWExrbTZMS2lMVmNHQ0JxVUV4ZFBfWGxVbFJRRXBDTTd3WDBTUTlxTEFPLVp2a0tEVXBtZnJwNU4zTWR2ZjNMVXpq\\u0026q=http%3A%2F%2Fwww.twentyfournews.com%2F\\u0026v=1wECsnGZcfc","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":603,"length":21,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBIQ040EGAQiEwiW8NCDn8eWAxVGClcBHcVzHNdI9-PljKfWwIDXAcoBBA1CCm8=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUM4Zm9rUVBVbnM3QWxGMVFQMndfaXBLanRGYXxBR3JiS2Fsd3BWUnFGNDRVeXo1UUxmSTFBQVcwNEx6eE9POVNxZFV2NE5admFhRXpNN3EzUjVaTHZ0ZWdRM3B6ZUxEeWhzSVJkLXMwWEVXZGtRQmZaSWl4a2k4TElKLTU2V0pK\\u0026q=https%3A%2F%2Fgoo.gl%2FQ5LMwv\\u0026v=1wECsnGZcfc","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUM4Zm9rUVBVbnM3QWxGMVFQMndfaXBLanRGYX