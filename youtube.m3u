 News to catch up on the latest trends and News.\\n\\nFacebook   : \xc2\xa0\xc2\xa0/\xc2\xa024onlive\xc2\xa0\xc2\xa0\\nTwitter        : \xc2\xa0\xc2\xa0/\xc2\xa024onlive\xc2\xa0\xc2\xa0\\nInstagram  : \xc2\xa0\xc2\xa0/\xc2\xa024onlive\xc2\xa0\xc2\xa0\\n\\n#MalayalamNews #latestnews #LiveUpdates  #24News","commandRuns":[{"startIndex":494,"length":29,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBIQ040EGAQiEwjM_8ap6JqWAxVEUsIBHX5sG1tI9-PljKfWwIDXAcoBBPGxFD4=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUM4Zm9rUkx5Wlg3SkwtSU5rMlRfRnJ2MXhUUHxBR3JiS2FsaXJ2bFgtdXlrMnFEWEVJZ0FoZlgtN1BvVEVSaDF2OHh5b2ppOXpQdFpzSzFtd3ZLQVFzV2RmQVk3Wjk5dVdSS0Z3d3MtS3hrRlZiZE13TVprZHhuY1VrUkdSclBw\\u0026q=http%3A%2F%2Fwww.twentyfournews.com%2F\\u0026v=1wECsnGZcfc","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUM4Zm9rUkx5Wlg3SkwtSU5rMlRfRnJ2MXhUUHxBR3JiS2FsaXJ2bFgtdXlrMnFEWEVJZ0FoZlgtN1BvVEVSaDF2OHh5b2ppOXpQdFpzSzFtd3ZLQVFzV2RmQVk3Wjk5dVdSS0Z3d3MtS3hrRlZiZE13TVprZHhuY1VrUkdSclBw\\u0026q=http%3A%2F%2Fwww.twentyfournews.com%2F\\u0026v=1wECsnGZcfc","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":603,"length":21,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBIQ040EGAQiEwjM_8ap6JqWAxVEUsIBHX5sG1tI9-PljKfWwIDXAcoBBPGxFD4=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUM4Zm9rUlpReVcxd1ZfSFFfWl80cDcyZUd4a3xBR3JiS2FrVGpWLUVrRG8tMW9HdjdDaEkwdmVSOTcyNmhNY25JMC1lVTlzNGVWNExmZl8xOXRMNzFDUm5CdkpmMlN3d25YSWNNallMOUxxc3ZUb1NwQkMzU1djbXlZcXN3YjUx\\u0026q=https%3A%2F%2Fgoo.gl%2FQ5LMwv\\u0026v=1wECsnGZcfc","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUM4Zm9rUlpReVcxd1ZfSFFfWl80cDcyZUd4a3xBR3JiS2FrVGpWLUVrRG8tMW9HdjdDaE