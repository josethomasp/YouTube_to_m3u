s.apple.com/in/app/million...\\n\\n\\nFollow Twentyfour News to catch up on the latest trends and News.\\n\\nFacebook   : \xc2\xa0\xc2\xa0/\xc2\xa024onlive\xc2\xa0\xc2\xa0\\nTwitter        : \xc2\xa0\xc2\xa0/\xc2\xa024onlive\xc2\xa0\xc2\xa0\\nInstagram  : \xc2\xa0\xc2\xa0/\xc2\xa024onlive\xc2\xa0\xc2\xa0\\n\\n#MalayalamNews #latestnews #LiveUpdates  #24News","commandRuns":[{"startIndex":495,"length":29,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBIQ040EGAQiEwjM97HE84qXAxX3DmgIHXk5BPFI9-PljKfWwIDXAcoBBFzoxBs=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUZZTVljR0dTQnpzUUxUeWR6Q3BxaWFDTW9vRXxBTl9pYzRkbFEtVk1UZ09reF9HYkhiX2NIZUt3N1k0WDdCM3pCby1BX0Nzd3JXa0VvX1ZGQ1RRX1pfUEdSWmdmTUdaQWtCNTJKUThOR0tVcnNHUklnX1Baemk1QWpoLUc1dWNI\\u0026q=http%3A%2F%2Fwww.twentyfournews.com%2F\\u0026v=1wECsnGZcfc","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUZZTVljR0dTQnpzUUxUeWR6Q3BxaWFDTW9vRXxBTl9pYzRkbFEtVk1UZ09reF9HYkhiX2NIZUt3N1k0WDdCM3pCby1BX0Nzd3JXa0VvX1ZGQ1RRX1pfUEdSWmdmTUdaQWtCNTJKUThOR0tVcnNHUklnX1Baemk1QWpoLUc1dWNI\\u0026q=http%3A%2F%2Fwww.twentyfournews.com%2F\\u0026v=1wECsnGZcfc","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":604,"length":21,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBIQ040EGAQiEwjM97HE84qXAxX3DmgIHXk5BPFI9-PljKfWwIDXAcoBBFzoxBs=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUZZTVljRVhyeU5wa0oyNUFyOUQ5NzdUNnBrdHxBTl9pYzRjdWpDZUFzNHhvMnY1eGdqSmcxbXVkcU1mLUZYY1dKOFRvLVVjd0ticERGNnRncHFLdHlOanZNeDFvWk9KdzBONENsSEJDekk4MWNidlBndmJ6WUNpVFpSdVo2V053\\u0026q=https%3A%2F%2Fgoo.gl%2FQ5LMwv\\u0026v=1wECsnGZcfc","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUZZTVljRVhyeU5