be. \\nhttps://goo.gl/Q5LMwv\\n\\nDownload The Million Malayali Club App from Playstore/App Store \\n\\nGoogle app store : https://play.google.com/store/apps/de...\\n\\nApple Store: https://apps.apple.com/in/app/million...\\n\\n\\nFollow Twentyfour News to catch up on the latest trends and News.\\n\\nFacebook   : \xc2\xa0\xc2\xa0/\xc2\xa024onlive\xc2\xa0\xc2\xa0\\nTwitter        : \xc2\xa0\xc2\xa0/\xc2\xa024onlive\xc2\xa0\xc2\xa0\\nInstagram  : \xc2\xa0\xc2\xa0/\xc2\xa024onlive\xc2\xa0\xc2\xa0\\n\\n#MalayalamNews #latestnews #LiveUpdates  #24News","commandRuns":[{"startIndex":495,"length":29,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBIQ040EGAQiEwip8buwnvOWAxVFLmgIHfMtMH9I9-PljKfWwIDXAcoBBCWs0Kc=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUZZTVljRnB6SXMyVGJzSXItZ0ZQWHZaa0QzbnxBTl9pYzRjc0l1aC1waXY3V1ZXUTRsVG9wblFnNm1ENk1OVGFYZ2tiVEVSaFpiQ3VHeFEzTVBkY3NhU2E1cGlGYzJiOHZjcnZZOU0tTmxfdVNoR1Z5WGRvbExaNWd1QTJuU2pP\\u0026q=http%3A%2F%2Fwww.twentyfournews.com%2F\\u0026v=1wECsnGZcfc","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUZZTVljRnB6SXMyVGJzSXItZ0ZQWHZaa0QzbnxBTl9pYzRjc0l1aC1waXY3V1ZXUTRsVG9wblFnNm1ENk1OVGFYZ2tiVEVSaFpiQ3VHeFEzTVBkY3NhU2E1cGlGYzJiOHZjcnZZOU0tTmxfdVNoR1Z5WGRvbExaNWd1QTJuU2pP\\u0026q=http%3A%2F%2Fwww.twentyfournews.com%2F\\u0026v=1wECsnGZcfc","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":604,"length":21,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBIQ040EGAQiEwip8buwnvOWAxVFLmgIHfMtMH9I9-PljKfWwIDXAcoBBCWs0Kc=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUZZTVljRVpIODdZaWFWZldvcWhLRzhINDF2cnxBTl9pYzRlVV9oaUktZlhLUm9DSlE0dXNnYzd0clc3cDNEV1JRRk9OUkttNGtsQUl5aEFHOEFkQTJ2bXJoOE41bWtPdWFDbkxHdXlPdjZodmxLNVJuRHZQWGdnekpoM2N2R1FF\\u0026q=https%3A%2F%2Fgoo.gl%2FQ5