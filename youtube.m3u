f\xe0\xb4\xaf  \xe0\xb4\xb5\xe0\xb4\xbe\xe0\xb5\xbc\xe0\xb4\xa4\xe0\xb5\x8d\xe0\xb4\xa4\xe0\xb4\x95\xe0\xb5\xbe\xe0\xb4\x95\xe0\xb5\x8d\xe0\xb4\x95\xe0\xb4\xbe\xe0\xb4\xaf\xe0\xb4\xbf \xe0\xb4\xb8\xe0\xb4\xa8\xe0\xb5\x8d\xe0\xb4\xa6\xe0\xb5\xbc\xe0\xb4\xb6\xe0\xb4\xbf\xe0\xb4\x95\xe0\xb5\x8d\xe0\xb4\x95\xe0\xb5\x81\xe0\xb4\x95 \\n== http://www.twentyfournews.com \\n\\n 24 News Live TV - Watch 24 Live Any Time anywhere Subscribe 24 on YouTube. \\nhttps://goo.gl/Q5LMwv\\n\\nDownload The Million Malayali Club App from Playstore/App Store \\n\\nGoogle app store : https://play.google.com/store/apps/de...\\n\\nApple Store: https://apps.apple.com/in/app/million...\\n\\n\\nFollow Twentyfour News to catch up on the latest trends and News.\\n\\nFacebook   : \xc2\xa0\xc2\xa0/\xc2\xa024onlive\xc2\xa0\xc2\xa0\\nTwitter        : \xc2\xa0\xc2\xa0/\xc2\xa024onlive\xc2\xa0\xc2\xa0\\nInstagram  : \xc2\xa0\xc2\xa0/\xc2\xa024onlive\xc2\xa0\xc2\xa0\\n\\n#MalayalamNews #latestnews #LiveUpdates  #24News","commandRuns":[{"startIndex":494,"length":29,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBIQ040EGAQiEwjfn-iikuqVAxUdDWgIHZMgEDhI9-PljKfWwIDXAcoBBGPvWck=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUM4Zm9rVFZXVXE2NkVxazY3UVV3bzlRSHNOdnxBR3JiS2FuMkpCTlhOQl96MV9zbnBjV0JxUTR2dEhnSF9xb3hLRkZGbEVlTUE3d1JMalNfOUlOZlRseDBfejBPNUR1MXFKOTB5R3A3YzNVQnVNSVYxRHJtV3FvSWVGMEVIcGVi\\u0026q=http%3A%2F%2Fwww.twentyfournews.com%2F\\u0026v=1wECsnGZcfc","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUM4Zm9rVFZXVXE2NkVxazY3UVV3bzlRSHNOdnxBR3JiS2FuMkpCTlhOQl96MV9zbnBjV0JxUTR2dEhnSF9xb3hLRkZGbEVlTUE3d1JMalNfOUlOZlRseDBfejBPNUR1MXFKOTB5R3A3YzNVQnVNSVYxRHJtV3FvSWVGMEVIcGVi\\u0026q=http%3A%2F%2Fwww.twentyfournews.com%2F\\u0026v=1wECsnGZcfc","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":603,"length":21,"onT