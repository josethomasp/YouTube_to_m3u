illion...\\n\\n\\nFollow Twentyfour News to catch up on the latest trends and News.\\n\\nFacebook   : \xc2\xa0\xc2\xa0/\xc2\xa024onlive\xc2\xa0\xc2\xa0\\nTwitter        : \xc2\xa0\xc2\xa0/\xc2\xa024onlive\xc2\xa0\xc2\xa0\\nInstagram  : \xc2\xa0\xc2\xa0/\xc2\xa024onlive\xc2\xa0\xc2\xa0\\n\\n#MalayalamNews #latestnews #LiveUpdates  #24News","commandRuns":[{"startIndex":494,"length":29,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBIQ040EGAQiEwjw5cSQ-pGWAxWefPIAHY1YNzhI9-PljKfWwIDXAcoBBCOrPNQ=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUM4Zm9rU1NBeTZvMmJKNWlIR2JVOWhtUHZhcXxBR3JiS2FrU184V3BlRXk1OGlhckNTVGlWWHNfQUJ3MHFuajZiZm5wOFY0bEd4aEZwRkVFVGJDZ3NVVHdiMzFta0pvRVgzZWRsWU5YWjJlXzZGYVc1SVhETF8wQmtpSU0xSjIx\\u0026q=http%3A%2F%2Fwww.twentyfournews.com%2F\\u0026v=1wECsnGZcfc","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUM4Zm9rU1NBeTZvMmJKNWlIR2JVOWhtUHZhcXxBR3JiS2FrU184V3BlRXk1OGlhckNTVGlWWHNfQUJ3MHFuajZiZm5wOFY0bEd4aEZwRkVFVGJDZ3NVVHdiMzFta0pvRVgzZWRsWU5YWjJlXzZGYVc1SVhETF8wQmtpSU0xSjIx\\u0026q=http%3A%2F%2Fwww.twentyfournews.com%2F\\u0026v=1wECsnGZcfc","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":603,"length":21,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBIQ040EGAQiEwjw5cSQ-pGWAxWefPIAHY1YNzhI9-PljKfWwIDXAcoBBCOrPNQ=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUM4Zm9rUnpWRllXUktZeDZ6Wl9YVVFBVmI5dXxBR3JiS2FrR1hVSTVUR3c2cG9mQkx4d0wwWlI5NmdmWjEzdzl5ZVd2VzItMG5LZnhSUnZ2NlN0dW1PMnY2MUtvTmwxdHhyYnVlaUNLR09yNENGUFFscURXT0VoaVZLV1VvU29T\\u0026q=https%3A%2F%2Fgoo.gl%2FQ5LMwv\\u0026v=1wECsnGZcfc","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUM4Zm9rUnpWRllXUktZeDZ6Wl9YVVFBVmI