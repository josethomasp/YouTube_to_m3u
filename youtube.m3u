live\xc2\xa0\xc2\xa0\\nInstagram  : \xc2\xa0\xc2\xa0/\xc2\xa024onlive\xc2\xa0\xc2\xa0\\n\\n#MalayalamNews #latestnews #LiveUpdates  #24News","commandRuns":[{"startIndex":495,"length":29,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBIQ040EGAQiEwie1IiQ8OKWAxV_NWgIHUcVGxNI9-PljKfWwIDXAcoBBLpU8-8=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUM4Zm9rUU5sc0FKQUxYTzFpZU51SE9KZ3pDeHxBTl9pYzRkZjBOeVpDSlZEMmRhQnJzT1BDaU5BYm9LOVp1LVlLTFdEVFBGV182LThXSzNCT1d4TjBiTExkektySTNpcmVwU3hMT0ZMVG1hVDdUNTlqTU53NXBhZUV5R3htUzNK\\u0026q=http%3A%2F%2Fwww.twentyfournews.com%2F\\u0026v=1wECsnGZcfc","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUM4Zm9rUU5sc0FKQUxYTzFpZU51SE9KZ3pDeHxBTl9pYzRkZjBOeVpDSlZEMmRhQnJzT1BDaU5BYm9LOVp1LVlLTFdEVFBGV182LThXSzNCT1d4TjBiTExkektySTNpcmVwU3hMT0ZMVG1hVDdUNTlqTU53NXBhZUV5R3htUzNK\\u0026q=http%3A%2F%2Fwww.twentyfournews.com%2F\\u0026v=1wECsnGZcfc","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":604,"length":21,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBIQ040EGAQiEwie1IiQ8OKWAxV_NWgIHUcVGxNI9-PljKfWwIDXAcoBBLpU8-8=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUM4Zm9rVFhpR2Z6bXZTSzNob3p5aFZWWFN3RnxBTl9pYzRlUkVsRlN3aGRCM2tCdzg2SmhWVzdsdzJpeW9pNkNMcnR5WlpGVWFFTnUybFNGU0xadFlvazAyMVB2ME13MjZTdktqb1hvNXhsVS1McjNibXh0VENfQTYxR2N2SThF\\u0026q=https%3A%2F%2Fgoo.gl%2FQ5LMwv\\u0026v=1wECsnGZcfc","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUM4Zm9rVFhpR2Z6bXZTSzNob3p5aFZWWFN3RnxBTl9pYzRlUkVsRlN3aGRCM2tCdzg2SmhWVzdsdzJpeW9pNkNMcnR5WlpGVWFFTnUybFNGU0xadFlvazAyMVB2ME13MjZTdktqb1hvNXhsVS1McjNibXh0VENfQTYxR2N2SThF\\u0026q=https%3A%2F%2Fgoo.gl%2FQ5LMwv\\u0026v=1wECsnGZcfc","ta