p from Playstore/App Store \\n\\nGoogle app store : https://play.google.com/store/apps/de...\\n\\nApple Store: https://apps.apple.com/in/app/million...\\n\\n\\nFollow Twentyfour News to catch up on the latest trends and News.\\n\\nFacebook   : \xc2\xa0\xc2\xa0/\xc2\xa024onlive\xc2\xa0\xc2\xa0\\nTwitter        : \xc2\xa0\xc2\xa0/\xc2\xa024onlive\xc2\xa0\xc2\xa0\\nInstagram  : \xc2\xa0\xc2\xa0/\xc2\xa024onlive\xc2\xa0\xc2\xa0\\n\\n#MalayalamNews #latestnews #LiveUpdates  #24News","commandRuns":[{"startIndex":494,"length":29,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBIQ040EGAQiEwjdhee9s5CWAxUBSfIAHePZHfVI9-PljKfWwIDXAcoBBNl5EgM=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUM4Zm9rUXRaSWlpYkZrYU1Wc0Z5bU5NUjZDYnxBR3JiS2FrV2ZZT1pMcUp4ZW1qRGNTdkxaYzVEb2Z2TDBiNzVENXhRQWxQUjdQZzFaWGVXZmlCeHRmOXRaNldtVmVmRkliNFcxMGwwR252NWJNN0tfYXNxaVBDSmgwR1lmSkN0\\u0026q=http%3A%2F%2Fwww.twentyfournews.com%2F\\u0026v=1wECsnGZcfc","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe":83769}},"urlEndpoint":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUM4Zm9rUXRaSWlpYkZrYU1Wc0Z5bU5NUjZDYnxBR3JiS2FrV2ZZT1pMcUp4ZW1qRGNTdkxaYzVEb2Z2TDBiNzVENXhRQWxQUjdQZzFaWGVXZmlCeHRmOXRaNldtVmVmRkliNFcxMGwwR252NWJNN0tfYXNxaVBDSmgwR1lmSkN0\\u0026q=http%3A%2F%2Fwww.twentyfournews.com%2F\\u0026v=1wECsnGZcfc","target":"TARGET_NEW_WINDOW","nofollow":true}}}},{"startIndex":603,"length":21,"onTap":{"innertubeCommand":{"clickTrackingParams":"CBIQ040EGAQiEwjdhee9s5CWAxUBSfIAHePZHfVI9-PljKfWwIDXAcoBBNl5EgM=","commandMetadata":{"webCommandMetadata":{"url":"https://www.youtube.com/redirect?event=video_description\\u0026redir_token=QUM4Zm9rVGxfY3E5UEVkM3NJM0RJQVJZLWtCTHxBR3JiS2FuUXd6U0g2d0V3cnkybC0xRW9rYWpRZmw5S01wS0ZubXBNUXlHUTVVZXFPZGRBQUw4eGcwUFJKM3FoNjRTVHJVOHdPRFp4M3dzZUk1aW5EQ21FTWRBZjc1NXUwaFJj\\u0026q=https%3A%2F%2Fgoo.gl%2FQ5LMwv\\u0026v=1wECsnGZcfc","webPageType":"WEB_PAGE_TYPE_UNKNOWN","rootVe