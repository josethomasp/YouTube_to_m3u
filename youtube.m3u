"invertedBackground":4286374883,"overlayBackground":3423221302},"colorSampledDescriptionBodyText":{"content":"24 News Live TV | Live News Updates | Malayalam News Live | HD Live Streaming |  24 News\\n\\n\\n#MalayalamNews #latestnews #LiveUpdates  #24News\\n\\nWatch \' 24 \'  Malayalam Channel HD Live Streaming for Malayalam Live News, Updates, Breaking News, Political News and Debates, Kerala news, Mollywood Entertainment News, Business News, and Health News.\\n\\nWatch programs Encounter, Good morning with Sreekandan Nair, Janakeeya Kodathi, 100 News and all other programs of 24 news live here...\\n\\n\xe0\xb4\x8f\xe0\xb4\xb1\xe0\xb5\x8d\xe0\xb4\xb1\xe0\xb4\xb5\xe0\xb5\x81\xe0\xb4\x82 \xe0\xb4\xaa\xe0\xb5\x81\xe0\xb4\xa4\xe0\xb4\xbf\xe0\xb4\xaf  \xe0\xb4\xb5\xe0\xb4\xbe\xe0\xb5\xbc\xe0\xb4\xa4\xe0\xb5\x8d\xe0\xb4\xa4\xe0\xb4\x95\xe0\xb5\xbe\xe0\xb4\x95\xe0\xb5\x8d\xe0\xb4\x95\xe0\xb4\xbe\xe0\xb4\xaf\xe0\xb4\xbf \xe0\xb4\xb8\xe0\xb4\xa8\xe0\xb5\x8d\xe0\xb4\xa6\xe0\xb5\xbc\xe0\xb4\xb6\xe0\xb4\xbf\xe0\xb4\x95\xe0\xb5\x8d\xe0\xb4\x95\xe0\xb5\x81\xe0\xb4\x95 \\n== http://www.twentyfournews.com \\n\\n#MalayalamNewsLive #MalayalamNews  #LiveNews  \\n\\n 24 News Live TV - Watch 24 Live Any Time anywhere Subscribe 24 on YouTube. \\nhttps://goo.gl/Q5LMwv\\n\\nFollow Twentyfour News to catch up on the latest trends and News.\\n\\nFacebook   : \xc2\xa0\xc2\xa0/\xc2\xa024onlive\xc2\xa0\xc2\xa0\\nTwitter        : \xc2\xa0\xc2\xa0/\xc2\xa024onlive\xc2\xa0\xc2\xa0\\nInstagram  : \xc2\xa0\xc2\xa0/\xc2\xa024onlive\xc2\xa0\xc2\xa0","commandRuns":[{"startIndex":91,"length":14,"onTap":{"innertubeCommand":{"clickTrackingParams":"CB0Q3NcEGBsiEwiGhc2u6feRAxX0mGUDHZnLOTjKAQRN6CO2","commandMetadata":{"webCommandMetadata":{"url":"/hashtag/malayalamnews","webPageType":"WEB_PAGE_TYPE_BROWSE","rootVe":6827,"apiUrl":"/youtubei/v1/browse"}},"browseEndpoint":{"browseId":"FEhashtag","params":"6gURCg1tYWxheWFsYW1uZXdzGAE%3D"}}},"loggingDirectives":{"trackingParams":"CB0Q3NcEGBsiEwiGhc2u6feRAxX0mGUD